{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/becker929/zpkt/lib/contracts/mixdesk-message.schema.json",
  "description": "The mix desk's messages: what the pager (inside Live) sends the server as UDP datagrams, and what the server streams to the page as server-sent events. Generated from contrib/mixdesk/protocol.py by contrib/mixdesk/gen_schema.py; do not edit by hand.",
  "$defs": {
    "ArrangementMessage": {
      "description": "The arrangement changed in Live (a clip or a locator came, went or moved): what the app read of it is stale.",
      "properties": {
        "t": {
          "const": "arr",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "t"
      ],
      "title": "ArrangementMessage",
      "type": "object"
    },
    "DeskMessage": {
      "description": "The pages changed (a surface made or removed): load /api/desk again and open page `open`.",
      "properties": {
        "t": {
          "const": "desk",
          "title": "T",
          "type": "string"
        },
        "open": {
          "title": "Open",
          "type": "integer"
        }
      },
      "required": [
        "t",
        "open"
      ],
      "title": "DeskMessage",
      "type": "object"
    },
    "FlagsMessage": {
      "description": "Which tracks are soloed and which muted, by their names in state keys (\"Kick bus\"). Sent whole on any change.",
      "properties": {
        "t": {
          "const": "flags",
          "title": "T",
          "type": "string"
        },
        "solo": {
          "items": {
            "type": "string"
          },
          "title": "Solo",
          "type": "array"
        },
        "mute": {
          "items": {
            "type": "string"
          },
          "title": "Mute",
          "type": "array"
        },
        "sys": {
          "title": "Sys",
          "type": "boolean"
        }
      },
      "required": [
        "t",
        "solo",
        "mute"
      ],
      "title": "FlagsMessage",
      "type": "object"
    },
    "FullMessage": {
      "description": "Everything at once (deskstate.DeskState): on connect, after a pager start, after a monitor change.",
      "properties": {
        "t": {
          "const": "full",
          "title": "T",
          "type": "string"
        },
        "state": {
          "additionalProperties": true,
          "title": "State",
          "type": "object"
        }
      },
      "required": [
        "t",
        "state"
      ],
      "title": "FullMessage",
      "type": "object"
    },
    "HardwareMessage": {
      "description": "A MiniLab control touched: where it physically is (None for a pad) and whether a fader has picked up.",
      "properties": {
        "t": {
          "const": "hw",
          "title": "T",
          "type": "string"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "slot": {
          "title": "Slot",
          "type": "string"
        },
        "hw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hw"
        },
        "picked": {
          "title": "Picked",
          "type": "boolean"
        }
      },
      "required": [
        "t",
        "page",
        "slot",
        "hw",
        "picked"
      ],
      "title": "HardwareMessage",
      "type": "object"
    },
    "HistoryMessage": {
      "description": "The history's last entries (history.History.view): moves, reverts and checkpoints, and where undo stands.",
      "properties": {
        "t": {
          "const": "hist",
          "title": "T",
          "type": "string"
        },
        "entries": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Entries",
          "type": "array"
        },
        "pos": {
          "title": "Pos",
          "type": "integer"
        },
        "can_undo": {
          "title": "Can Undo",
          "type": "boolean"
        },
        "can_redo": {
          "title": "Can Redo",
          "type": "boolean"
        },
        "checkpoints": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Checkpoints",
          "type": "array"
        },
        "undo": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Undo"
        },
        "redo": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Redo"
        }
      },
      "required": [
        "t",
        "entries",
        "pos",
        "can_undo",
        "can_redo",
        "checkpoints"
      ],
      "title": "HistoryMessage",
      "type": "object"
    },
    "LoopMessage": {
      "properties": {
        "t": {
          "const": "loop",
          "title": "T",
          "type": "string"
        },
        "loop": {
          "title": "Loop",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "length": {
          "title": "Length",
          "type": "number"
        }
      },
      "required": [
        "t",
        "loop"
      ],
      "title": "LoopMessage",
      "type": "object"
    },
    "MeterMessage": {
      "description": "The live meter on Main: third-octave band centres and their levels in dB.",
      "properties": {
        "t": {
          "const": "meter",
          "title": "T",
          "type": "string"
        },
        "hz": {
          "items": {
            "type": "number"
          },
          "title": "Hz",
          "type": "array"
        },
        "db": {
          "items": {
            "type": "number"
          },
          "title": "Db",
          "type": "array"
        }
      },
      "required": [
        "t",
        "hz",
        "db"
      ],
      "title": "MeterMessage",
      "type": "object"
    },
    "MonitorMessage": {
      "description": "What is heard: slot A, B, W or C, and the reference C plays.",
      "properties": {
        "t": {
          "const": "mon",
          "title": "T",
          "type": "string"
        },
        "slot": {
          "title": "Slot",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "err": {
          "title": "Err",
          "type": "string"
        }
      },
      "required": [
        "t",
        "slot",
        "ref"
      ],
      "title": "MonitorMessage",
      "type": "object"
    },
    "PadMessage": {
      "description": "A pad pressed on the MiniLab that holds a compare state of the armed page: the app writes the state.",
      "properties": {
        "t": {
          "const": "pad",
          "title": "T",
          "type": "string"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "slot": {
          "title": "Slot",
          "type": "string"
        }
      },
      "required": [
        "t",
        "page",
        "slot"
      ],
      "title": "PadMessage",
      "type": "object"
    },
    "PageMessage": {
      "description": "A page armed on the MiniLab.",
      "properties": {
        "t": {
          "const": "page",
          "title": "T",
          "type": "string"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "picked": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Picked",
          "type": "object"
        }
      },
      "required": [
        "t",
        "page",
        "picked"
      ],
      "title": "PageMessage",
      "type": "object"
    },
    "PositionMessage": {
      "description": "The playhead: beat and whether Live plays.",
      "properties": {
        "t": {
          "const": "pos",
          "title": "T",
          "type": "string"
        },
        "b": {
          "title": "B",
          "type": "number"
        },
        "p": {
          "title": "P",
          "type": "boolean"
        },
        "bpm": {
          "title": "Bpm",
          "type": "number"
        }
      },
      "required": [
        "t",
        "b",
        "p"
      ],
      "title": "PositionMessage",
      "type": "object"
    },
    "StepKnobMessage": {
      "description": "Knob 1, 2 or 3 turned in the steps layer: the velocity, the length (in steps) or the swing of a new step.",
      "properties": {
        "t": {
          "const": "step_knob",
          "title": "T",
          "type": "string"
        },
        "what": {
          "enum": [
            "velocity",
            "length",
            "swing"
          ],
          "title": "What",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "t",
        "what",
        "value"
      ],
      "title": "StepKnobMessage",
      "type": "object"
    },
    "StepPadMessage": {
      "description": "A pad pressed in the steps layer: step pad 0-15 of the bar in view (bank A is 0-7, bank B is 8-15).",
      "properties": {
        "t": {
          "const": "step",
          "title": "T",
          "type": "string"
        },
        "pad": {
          "title": "Pad",
          "type": "integer"
        }
      },
      "required": [
        "t",
        "pad"
      ],
      "title": "StepPadMessage",
      "type": "object"
    },
    "StepSoundMessage": {
      "description": "A sound chosen on the MiniLab in the steps layer: the data knob turned (`turn` sounds on, or back), or a pad\nof the track's Drum Rack selected in Live, as a played key does (`pitch`, the pad's note).",
      "properties": {
        "t": {
          "const": "step_sound",
          "title": "T",
          "type": "string"
        },
        "turn": {
          "title": "Turn",
          "type": "integer"
        },
        "pitch": {
          "title": "Pitch",
          "type": "integer"
        }
      },
      "required": [
        "t"
      ],
      "title": "StepSoundMessage",
      "type": "object"
    },
    "StepsEdit": {
      "description": "A pattern was changed through the app: which one, and by which command.",
      "properties": {
        "track": {
          "title": "Track",
          "type": "string"
        },
        "bar": {
          "title": "Bar",
          "type": "integer"
        },
        "bars": {
          "title": "Bars",
          "type": "integer"
        },
        "what": {
          "title": "What",
          "type": "string"
        }
      },
      "required": [
        "track",
        "bar",
        "bars",
        "what"
      ],
      "title": "StepsEdit",
      "type": "object"
    },
    "StepsFocus": {
      "description": "What the step sequencer is editing (zpkt.app.steps_commands.focus): a pattern, a sound, its steps.",
      "properties": {
        "track": {
          "title": "Track",
          "type": "string"
        },
        "bar": {
          "title": "Bar",
          "type": "integer"
        },
        "bars": {
          "title": "Bars",
          "type": "integer"
        },
        "steps_per_bar": {
          "title": "Steps Per Bar",
          "type": "integer"
        },
        "view": {
          "title": "View",
          "type": "integer"
        },
        "pitch": {
          "title": "Pitch",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "velocity": {
          "title": "Velocity",
          "type": "integer"
        },
        "length": {
          "title": "Length",
          "type": "number"
        },
        "swing": {
          "title": "Swing",
          "type": "number"
        },
        "steps": {
          "items": {
            "type": "integer"
          },
          "title": "Steps",
          "type": "array"
        },
        "blocked": {
          "title": "Blocked",
          "type": "boolean"
        },
        "rev": {
          "title": "Rev",
          "type": "integer"
        }
      },
      "required": [
        "track",
        "bar",
        "bars",
        "steps_per_bar",
        "view",
        "pitch",
        "name",
        "velocity",
        "length",
        "swing",
        "steps",
        "blocked",
        "rev"
      ],
      "title": "StepsFocus",
      "type": "object"
    },
    "StepsMessage": {
      "description": "The step sequencer's focus, sent whole whenever it changes (None: nothing is being edited), and after every\nchange to a pattern (`edit`). A controller lights its pads from focus.steps and turns a pad press into\nsteps.toggle with the focus and a step number.",
      "properties": {
        "t": {
          "const": "steps",
          "title": "T",
          "type": "string"
        },
        "focus": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepsFocus"
            },
            {
              "type": "null"
            }
          ]
        },
        "src": {
          "title": "Src",
          "type": "string"
        },
        "edit": {
          "$ref": "#/$defs/StepsEdit"
        }
      },
      "required": [
        "t",
        "focus"
      ],
      "title": "StepsMessage",
      "type": "object"
    },
    "SurfaceMessage": {
      "description": "How the \"Make a surface\" job is going.",
      "properties": {
        "t": {
          "const": "surface",
          "title": "T",
          "type": "string"
        },
        "status": {
          "enum": [
            "working",
            "done",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "msg": {
          "title": "Msg",
          "type": "string"
        }
      },
      "required": [
        "t",
        "status",
        "msg"
      ],
      "title": "SurfaceMessage",
      "type": "object"
    },
    "ValueMessage": {
      "description": "A control's value moved in Live (by anything): page:slot, its 0..1 position, what Live shows, the raw value.",
      "properties": {
        "t": {
          "const": "v",
          "title": "T",
          "type": "string"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "slot": {
          "title": "Slot",
          "type": "string"
        },
        "n": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "N"
        },
        "s": {
          "title": "S",
          "type": "string"
        },
        "r": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "R"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Key"
        },
        "sys": {
          "title": "Sys",
          "type": "boolean"
        },
        "who": {
          "enum": [
            "you",
            "minilab",
            "agent",
            "sys"
          ],
          "title": "Who",
          "type": "string"
        }
      },
      "required": [
        "t",
        "page",
        "slot",
        "n",
        "s",
        "r",
        "key"
      ],
      "title": "ValueMessage",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/ValueMessage"
    },
    {
      "$ref": "#/$defs/PositionMessage"
    },
    {
      "$ref": "#/$defs/MonitorMessage"
    },
    {
      "$ref": "#/$defs/LoopMessage"
    },
    {
      "$ref": "#/$defs/PageMessage"
    },
    {
      "$ref": "#/$defs/HardwareMessage"
    },
    {
      "$ref": "#/$defs/PadMessage"
    },
    {
      "$ref": "#/$defs/FlagsMessage"
    },
    {
      "$ref": "#/$defs/ArrangementMessage"
    },
    {
      "$ref": "#/$defs/StepPadMessage"
    },
    {
      "$ref": "#/$defs/StepKnobMessage"
    },
    {
      "$ref": "#/$defs/StepSoundMessage"
    },
    {
      "$ref": "#/$defs/FullMessage"
    },
    {
      "$ref": "#/$defs/HistoryMessage"
    },
    {
      "$ref": "#/$defs/MeterMessage"
    },
    {
      "$ref": "#/$defs/SurfaceMessage"
    },
    {
      "$ref": "#/$defs/DeskMessage"
    },
    {
      "$ref": "#/$defs/StepsMessage"
    }
  ]
}
