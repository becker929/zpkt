{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/becker929/zpkt/lib/contracts/booth-job.schema.json",
  "$defs": {
    "JobError": {
      "description": "Why a job failed or is held. `retryable`: sending the same score again later may work.",
      "properties": {
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "stage",
        "code",
        "message",
        "retryable"
      ],
      "title": "JobError",
      "type": "object"
    },
    "Measure": {
      "additionalProperties": true,
      "description": "measure.json, and a done job's `measure`. Every level is None for a silent render (which never finishes).",
      "properties": {
        "seconds": {
          "title": "Seconds",
          "type": "number"
        },
        "sample_rate": {
          "title": "Sample Rate",
          "type": "integer"
        },
        "lufs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lufs"
        },
        "true_peak_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "True Peak Db"
        },
        "phone_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "the level above 180 Hz against the whole, dB: the phone speaker model",
          "title": "Phone Db"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Sections",
          "type": "array"
        },
        "flags": {
          "items": {
            "enum": [
              "silent",
              "clipping",
              "too_quiet",
              "no_contrast",
              "lost_on_phone"
            ],
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "notes": {
          "description": "each flag in plain words, in the same order",
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "master_gain_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "only when a quiet first export was made louder in Live",
          "title": "Master Gain Db"
        }
      },
      "required": [
        "seconds",
        "sample_rate",
        "lufs",
        "true_peak_db",
        "phone_db",
        "sections",
        "flags",
        "notes"
      ],
      "title": "Measure",
      "type": "object"
    },
    "Section": {
      "properties": {
        "label": {
          "description": "\"section 1\", \"section 2\", ... in song order",
          "title": "Label",
          "type": "string"
        },
        "start_s": {
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "title": "End S",
          "type": "number"
        },
        "lufs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "None when the section is too short or silent to measure",
          "title": "Lufs"
        }
      },
      "required": [
        "label",
        "start_s",
        "end_s",
        "lufs"
      ],
      "title": "Section",
      "type": "object"
    }
  },
  "description": "GET /v1/jobs/{id}, and the answer to POST /v1/jobs (202 for a new job, with `eta_s`; 200 for a key the booth\nalready has, without it). Generated from contrib/booth/src/booth/contract.py (Job) \u2014 do not edit by hand.",
  "properties": {
    "job": {
      "pattern": "^[a-z0-9]{12}$",
      "title": "Job",
      "type": "string"
    },
    "key": {
      "title": "Key",
      "type": "string"
    },
    "state": {
      "enum": [
        "queued",
        "building",
        "rendering",
        "measuring",
        "done",
        "failed",
        "held"
      ],
      "title": "State",
      "type": "string"
    },
    "stage": {
      "description": "the step in progress (\"open\", \"load p2\", \"export\", \"encode\"), \"\" when none",
      "title": "Stage",
      "type": "string"
    },
    "parent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent"
    },
    "position": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "place in the queue from 1, None when not queued",
      "title": "Position"
    },
    "timings": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "seconds per finished step",
      "title": "Timings",
      "type": "object"
    },
    "measure": {
      "anyOf": [
        {
          "$ref": "#/$defs/Measure"
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "description": "the files GET /v1/jobs/{id}/files/{name} serves; empty until done",
      "items": {
        "enum": [
          "render.m4a",
          "video.mp4",
          "still.jpg",
          "score.json",
          "measure.json",
          "loop.m4a"
        ],
        "type": "string"
      },
      "title": "Files",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/JobError"
        },
        {
          "type": "null"
        }
      ]
    },
    "eta_s": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "only on POST /v1/jobs 202: seconds of Live time queued, this one included",
      "title": "Eta S"
    }
  },
  "required": [
    "job",
    "key",
    "state",
    "stage",
    "parent",
    "position",
    "timings",
    "measure",
    "files",
    "error"
  ],
  "title": "Job",
  "type": "object"
}
