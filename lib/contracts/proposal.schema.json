{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/becker929/zpkt/lib/contracts/proposal.schema.json",
  "title": "Option",
  "description": "A change an agent proposed for the person to pick (options.json in the Ask folder). Proposing moves nothing in Live.",
  "type": "object",
  "required": [
    "id",
    "title",
    "why",
    "moves",
    "made_by",
    "state"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "why": {
      "type": "string",
      "maxLength": 1000
    },
    "moves": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "target",
          "to"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "to": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    "made_by": {
      "enum": [
        "you",
        "minilab",
        "agent",
        "booth",
        "demo",
        "cli",
        "sys"
      ]
    },
    "at": {
      "type": "string"
    },
    "session": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "proposed"
      ]
    }
  }
}
