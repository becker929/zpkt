# ── Letta server ──────────────────────────────────────────────────────────────
# Run locally with Docker (macOS/Windows):
#
#   docker run \
#     -v ~/.letta/.persist/pgdata:/var/lib/postgresql/data \
#     -p 8283:8283 \
#     -e ANTHROPIC_API_KEY="sk-ant-..." \
#     -e OLLAMA_BASE_URL="http://host.docker.internal:11434/v1" \
#     letta/letta:latest
#
# Linux: replace host.docker.internal with localhost and add --network host
LETTA_API_KEY=
LETTA_BASE_URL=http://localhost:8283

# ── LLM provider ──────────────────────────────────────────────────────────────
# Anthropic — required for the default agent (claude-sonnet-4-5)
ANTHROPIC_API_KEY=sk-ant-...

# ── Embedding (Google Gemini) ─────────────────────────────────────────────────
# google-ai/text-embedding-004 via Gemini API — fast, high quality, free tier.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ── Vibe audio output directory ───────────────────────────────────────────────
# Where the Python vibe server writes bounced WAV/MP3 files.
# The Next.js /api/audio/[filename] route reads from here.
VIBE_OUTPUT_DIR=/tmp/vibe

# ── Vibe server URL ───────────────────────────────────────────────────────────
# Server-side URL (Next.js API routes → vibe server). localhost is fine here.
VIBE_SERVER_URL=http://localhost:8080
# Public URL used by the browser (must be reachable from remote clients).
# Set to your Tailscale IP when serving over Tailscale, e.g.:
# NEXT_PUBLIC_VIBE_SERVER_URL=http://100.x.x.x:8080
NEXT_PUBLIC_VIBE_SERVER_URL=http://localhost:8080

# ── App behaviour ─────────────────────────────────────────────────────────────
USE_COOKIE_BASED_AUTHENTICATION=true
NEXT_PUBLIC_CREATE_AGENTS_FROM_UI=true
