        "k2": {"track": "Break bus", "device": "desk EQ", "param": "4 Gain A", "label": "Mid gain"},
        "k3": {"track": "Break bus", "device": "desk EQ", "param": "4 Frequency A", "label": "Mid freq"},
        "k4": {"track": "Break bus", "device": "desk Sat", "param": "Drive", "label": "Sat drive"},
        "k5": {"track": "Break bus", "device": "desk Sat", "param": "Dry/Wet", "label": "Sat wet"},
        "k6": {"track": "Break bus", "device": "desk Glue", "param": "Threshold", "label": "Glue thresh"},
        "k7": {"track": "Break bus", "device": "desk Glue", "param": "Dry/Wet", "label": "Glue wet"},
        "k8": {"track": "Break bus", "param": "send:Space", "label": "→ Space"},
        "b1": {"track": "Break bus", "device": "desk EQ", "param": "1 Filter On A", "label": "Low cut on"},
        "b2": {"track": "Break bus", "device": "desk Sat", "param": "Device On", "label": "Sat on"},
        "b3": {"track": "Break bus", "device": "desk Glue", "param": "Device On", "label": "Glue on"},
        "b8": {"track": "Break bus", "param": "solo"}
      }
    },
    {
      "name": "Chord + perc",
      "what": "The chord loop, splash and crash; colour on the chord bus, air on perc",
      "controls": {
        "f1": {"track": "chord", "param": "volume", "label": "Chord"},
        "f2": {"track": "splash", "param": "volume", "label": "Splash"},
        "f3": {"track": "crash", "param": "volume", "label": "Crash"},
        "f4": {"track": "Chord and splash bus", "param": "volume", "label": "Chord bus"},
        "k1": {"track": "Chord and splash bus", "device": "desk EQ", "param": "1 Frequency A", "label": "Chord low cut"},
        "k2": {"track": "Chord and splash bus", "device": "desk EQ", "param": "4 Gain A", "label": "Chord 1.6k"},
        "k3": {"track": "Chord and splash bus", "device": "desk Sat", "param": "Drive", "label": "Chord drive"},
        "k4": {"track": "Chord and splash bus", "device": "desk Sat", "param": "Dry/Wet", "label": "Chord sat wet"},
        "k5": {"track": "Perc bus", "device": "desk EQ", "param": "1 Frequency A", "label": "Perc low cut"},
        "k6": {"track": "Perc bus", "device": "desk EQ", "param": "7 Gain A", "label": "Perc air"},
        "k7": {"track": "Chord and splash bus", "param": "send:Space", "label": "Chord → Space"},
        "k8": {"track": "Chord and splash bus", "param": "send:Echo", "label": "Chord → Echo"},
        "b1": {"track": "Chord and splash bus", "device": "desk EQ", "param": "1 Filter On A", "label": "Chord cut on"},
        "b2": {"track": "Chord and splash bus", "device": "desk Sat", "param": "Device On", "label": "Chord sat on"},
        "b3": {"track": "Perc bus", "device": "desk EQ", "param": "1 Filter On A", "label": "Perc cut on"},
        "b7": {"track": "Perc bus", "param": "solo"},
        "b8": {"track": "Chord and splash bus", "param": "solo"}
      }
    },
    {
      "name": "Transitions",
      "what": "Risers, reverse reverbs, fills and downlifters",
      "controls": {
        "f1": {"track": "fx-riser", "param": "volume", "label": "Risers"},
        "f2": {"track": "fx-reverse", "param": "volume", "label": "Reverse"},
        "f3": {"track": "fx-fill", "param": "volume", "label": "Fills"},
        "f4": {"track": "fx-downlifter", "param": "volume", "label": "Downlifters"},
        "k1": {"track": "Transitions bus", "param": "volume"},
        "k2": {"track": "Transitions bus", "device": "desk EQ", "param": "1 Frequency A", "label": "Low cut"},
