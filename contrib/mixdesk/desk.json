{
  "set": "HW002_121_pp_finish",
  "controller": "Arturia MiniLab 3",
  "note": "Eight pages. Pads 1-8 of bank A arm a page (so does the big encoder); the page's faders f1-f4, knobs k1-k8 and bank-B pads b1-b8 then drive what it lists. A control is a track and either volume, pan, send:<return>, mute, solo, or a device and one of its parameters. Faders pick up: they act once they pass the value Live has.",
  "pages": [
    {
      "name": "Buses",
      "what": "The six group buses against each other, their sends, and the headroom",
      "controls": {
        "f1": {"track": "Kick bus", "param": "volume"},
        "f2": {"track": "Hats bus", "param": "volume"},
        "f3": {"track": "Break bus", "param": "volume"},
        "f4": {"track": "Chord and splash bus", "param": "volume"},
        "k1": {"track": "Perc bus", "param": "volume"},
        "k2": {"track": "Transitions bus", "param": "volume"},
        "k3": {"track": "Hats bus", "param": "send:Space", "label": "Hats → Space"},
        "k4": {"track": "Perc bus", "param": "send:Space", "label": "Perc → Space"},
        "k5": {"track": "Chord and splash bus", "param": "send:Space", "label": "Chord → Space"},
        "k6": {"track": "Break bus", "param": "send:Space", "label": "Break → Space"},
        "k7": {"track": "Break bus", "param": "send:Echo", "label": "Break → Echo"},
        "k8": {"track": "Main", "device": "desk headroom", "param": "Output", "label": "Headroom"},
        "b1": {"track": "Kick bus", "param": "mute"},
        "b2": {"track": "Hats bus", "param": "mute"},
        "b3": {"track": "Break bus", "param": "mute"},
        "b4": {"track": "Chord and splash bus", "param": "mute"},
        "b5": {"track": "Perc bus", "param": "mute"},
        "b6": {"track": "Transitions bus", "param": "mute"},
        "b7": {"track": "Space", "param": "mute"},
        "b8": {"track": "Echo", "param": "mute"}
      }
    },
    {
      "name": "Kick",
      "what": "Crest and body: clip the beater spike, bring back sub and knock (mix notes 18 Nov)",
      "controls": {
        "f1": {"track": "kick", "param": "volume", "label": "Kick"},
        "f2": {"track": "Kick bus", "param": "volume"},
        "f3": {"track": "Kick bus", "device": "desk Sat", "param": "Dry/Wet", "label": "Sat wet"},
        "f4": {"track": "Kick bus", "device": "desk Glue", "param": "Dry/Wet", "label": "Glue wet"},
        "k1": {"track": "Kick bus", "device": "desk Sat", "param": "Drive", "label": "Sat drive"},
        "k2": {"track": "Kick bus", "device": "desk Sat", "param": "Output", "label": "Sat out"},
        "k3": {"track": "Kick bus", "device": "desk EQ", "param": "2 Gain A", "label": "Sub gain"},
        "k4": {"track": "Kick bus", "device": "desk EQ", "param": "2 Frequency A", "label": "Sub freq"},
        "k5": {"track": "Kick bus", "device": "desk EQ", "param": "4 Gain A", "label": "Knock gain"},
        "k6": {"track": "Kick bus", "device": "desk EQ", "param": "4 Frequency A", "label": "Knock freq"},
        "k7": {"track": "Kick bus", "device": "desk Glue", "param": "Threshold", "label": "Glue thresh"},
        "k8": {"track": "Kick bus", "device": "desk Glue", "param": "Output", "label": "Glue out"},
        "b1": {"track": "Kick bus", "device": "desk EQ", "param": "1 Filter On A", "label": "Low cut"},
        "b2": {"track": "Kick bus", "device": "desk Sat", "param": "Device On", "label": "Sat on"},
        "b3": {"track": "Kick bus", "device": "desk Glue", "param": "Device On", "label": "Glue on"},
        "b4": {"track": "kick", "device": "EQ Eight", "param": "Device On", "label": "KSMS match EQ"},
        "b5": {"track": "Kick bus", "device": "desk Sat", "param": "Post Clip Mode", "label": "Sat clip"},
        "b8": {"track": "Kick bus", "param": "solo"}
      }
    },
    {
      "name": "Hats",
      "what": "The seven hat lanes in ramp order, air and grit on the hats bus",
      "controls": {
        "f1": {"track": "p1-rd", "param": "volume"},
        "f2": {"track": "p1-oh66", "param": "volume"},
        "f3": {"track": "p2-rd2", "param": "volume"},
        "f4": {"track": "p2-rd1", "param": "volume"},
        "k1": {"track": "p2-oh", "param": "volume"},
        "k2": {"track": "p2-ch27", "param": "volume"},
        "k3": {"track": "p2-ch1", "param": "volume"},
        "k4": {"track": "Hats bus", "device": "desk EQ", "param": "7 Gain A", "label": "Air"},
        "k5": {"track": "Hats bus", "device": "desk EQ", "param": "1 Frequency A", "label": "Low cut"},
        "k6": {"track": "Hats bus", "device": "desk Sat", "param": "Drive", "label": "Sat drive"},
