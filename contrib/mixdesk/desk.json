        "k5": {"track": "Transitions bus", "param": "send:Space", "label": "→ Space"},
        "k6": {"track": "Transitions bus", "param": "send:Echo", "label": "→ Echo"},
        "b1": {"track": "Transitions bus", "device": "desk EQ", "param": "1 Filter On A", "label": "Low cut on"},
        "b8": {"track": "Transitions bus", "param": "solo"}
      }
    },
    {
      "name": "Space",
      "what": "The two returns: a Reverb and an Echo, fed from the bus sends",
      "controls": {
        "f1": {"track": "Space", "param": "volume", "label": "Space return"},
        "f2": {"track": "Echo", "param": "volume", "label": "Echo return"},
        "f3": {"track": "Hats bus", "param": "send:Space", "label": "Hats → Space"},
        "f4": {"track": "Perc bus", "param": "send:Space", "label": "Perc → Space"},
        "k1": {"track": "Space", "device": "Reverb", "param": "Decay Time", "label": "Decay"},
        "k2": {"track": "Space", "device": "Reverb", "param": "Predelay"},
        "k3": {"track": "Space", "device": "Reverb", "param": "Room Size", "label": "Size"},
        "k4": {"track": "Space", "device": "Reverb", "param": "Input Freq", "label": "In filter"},
        "k5": {"track": "Space", "device": "Reverb", "param": "HiShelf Gain", "label": "Hi shelf"},
        "k6": {"track": "Space", "device": "Reverb", "param": "Stereo Image", "label": "Width"},
        "k7": {"track": "Echo", "device": "Echo", "param": "Feedback"},
        "k8": {"track": "Echo", "device": "Echo", "param": "L 16th", "label": "Echo time"},
        "b1": {"track": "Space", "device": "Reverb", "param": "In Lo Cut On", "label": "Rev lo cut"},
        "b2": {"track": "Echo", "device": "Echo", "param": "Filter On", "label": "Echo filter"},
        "b7": {"track": "Space", "param": "solo"},
        "b8": {"track": "Echo", "param": "solo"}
      }
    },
    {
      "name": "Main",
      "what": "Glue, width and mono low end on Main (mix notes: side under 120 Hz too high)",
      "controls": {
        "f1": {"track": "Main", "device": "desk Glue", "param": "Dry/Wet", "label": "Glue wet"},
        "f2": {"track": "Main", "device": "desk Glue", "param": "Threshold", "label": "Glue thresh"},
        "f3": {"track": "Main", "device": "desk Utility", "param": "Stereo Width", "label": "Width"},
        "f4": {"track": "Main", "device": "desk headroom", "param": "Output", "label": "Headroom"},
        "k1": {"track": "Main", "device": "desk Glue", "param": "Ratio", "label": "Glue ratio"},
