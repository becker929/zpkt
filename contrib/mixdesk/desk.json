        "k8": {"track": "Hats bus", "param": "send:Space", "label": "→ Space"},
        "b1": {"track": "Hats bus", "device": "desk EQ", "param": "1 Filter On A", "label": "Low cut on"},
        "b2": {"track": "Hats bus", "device": "desk Sat", "param": "Device On", "label": "Sat on"},
        "b8": {"track": "Hats bus", "param": "solo"}
      }
    },
    {
      "name": "Break",
      "what": "Horn, stab, chop and beatbox; body and glue on the break bus",
      "controls": {
        "f1": {"track": "break-horn", "param": "volume", "label": "Horn"},
        "f2": {"track": "break-stab", "param": "volume", "label": "Stab"},
