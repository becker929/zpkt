        "k2": {
          "track": "Transitions bus",
          "param": "volume"
        },
        "k3": {
          "track": "Hats bus",
          "param": "send:Space",
          "label": "Hats → Space"
        },
        "k4": {
          "track": "Perc bus",
          "param": "send:Space",
          "label": "Perc → Space"
        },
        "k5": {
          "track": "Chord and splash bus",
