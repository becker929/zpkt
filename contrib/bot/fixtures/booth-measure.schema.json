{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/becker929/zpkt/lib/contracts/booth-measure.schema.json",
  "$defs": {
    "Section": {
      "properties": {
        "label": {
          "description": "\"section 1\", \"section 2\", ... in song order",
          "title": "Label",
          "type": "string"
        },
        "start_s": {
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "title": "End S",
          "type": "number"
        },
        "lufs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "None when the section is too short or silent to measure",
          "title": "Lufs"
        }
      },
      "required": [
        "label",
        "start_s",
        "end_s",
        "lufs"
      ],
      "title": "Section",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "measure.json, and a done job's `measure`. Every level is None for a silent render (which never finishes). Generated from contrib/booth/src/booth/contract.py (Measure) \u2014 do not edit by hand.",
  "properties": {
    "seconds": {
      "title": "Seconds",
      "type": "number"
    },
    "sample_rate": {
      "title": "Sample Rate",
      "type": "integer"
    },
    "lufs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Lufs"
    },
    "true_peak_db": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "True Peak Db"
    },
    "phone_db": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "the level above 180 Hz against the whole, dB: the phone speaker model",
      "title": "Phone Db"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "title": "Sections",
      "type": "array"
    },
    "flags": {
      "items": {
        "enum": [
          "silent",
          "clipping",
          "too_quiet",
          "no_contrast",
          "lost_on_phone"
        ],
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    },
    "notes": {
      "description": "each flag in plain words, in the same order",
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "master_gain_db": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "only when a quiet first export was made louder in Live",
      "title": "Master Gain Db"
    }
  },
  "required": [
    "seconds",
    "sample_rate",
    "lufs",
    "true_peak_db",
    "phone_db",
    "sections",
    "flags",
    "notes"
  ],
  "title": "Measure",
  "type": "object"
}
