{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/scalingtaste/ears/schemas/audio-profile.schema.json",
  "title": "AudioProfile",
  "description": "Structured perceptual description of an audio file. Produced by ears, consumed by taste.",
  "type": "object",
  "required": ["clip_id", "source_path"],
  "properties": {
    "clip_id":          { "type": "string" },
    "source_path":      { "type": "string" },
    "duration_seconds": { "type": "number", "minimum": 0 },
    "spectral": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "centroid_hz":   { "type": ["number", "null"] },
            "bandwidth_hz":  { "type": ["number", "null"] },
            "rolloff_hz":    { "type": ["number", "null"] },
            "flatness":      { "type": ["number", "null"] },
            "mfcc":          { "type": "array", "items": { "type": "number" } }
          }
        },
        { "type": "null" }
      ]
    },
    "loudness": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "lufs_integrated":  { "type": ["number", "null"] },
            "lufs_short_term":  { "type": ["number", "null"] },
            "true_peak_dbfs":   { "type": ["number", "null"] },
            "dynamic_range_db": { "type": ["number", "null"] },
            "key":              { "type": ["string", "null"] }
          }
        },
        { "type": "null" }
      ]
    },
    "rhythm": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "bpm":           { "type": ["number", "null"] },
            "beat_strength": { "type": ["number", "null"] },
            "swing_ratio":   { "type": ["number", "null"] }
          }
        },
        { "type": "null" }
      ]
    },
    "pitch": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "fundamental_hz":      { "type": ["number", "null"] },
            "polyphony_estimate":  { "type": ["integer", "null"] }
          }
        },
        { "type": "null" }
      ]
    },
    "embedding": {
      "oneOf": [
        { "type": "array", "items": { "type": "number" }, "minItems": 1 },
        { "type": "null" }
      ]
    },
    "description": { "type": ["string", "null"] },
    "errors":       { "type": "array", "items": { "type": "string" } }
  }
}
