#!/bin/bash
# Run a learn-tutorial script (or any helper) in the uv project it needs, at low priority.
#
#   $S/run onsets.py WAV --bpm 123 ...          # a script in this folder
#   $S/run W/tools/verify_x.py ARGS             # any other file (a path with a /): ears/mlab
#   $S/run --in hands W/practice/tools/x.py     # any file, in a chosen project: mlab | hands | voice
#   $S/run --hands live modals                  # the hands CLI
#   $S/run --which transcribe.py                # print the project only
#
# transcribe.py      -> lib/voice  (parakeet-mlx; HF_HUB_OFFLINE=1, the model is cached)
# preflight.py, live_step.py, render.py -> hands  (Live's GUI and LOM)
# everything else    -> ears/mlab  (numpy, scipy, soundfile, the calibrated meters)
#
# --no-sync is deliberate: a plain `uv run` would sync lib/voice without its `engines` extra and
# remove parakeet-mlx, and in a fresh worktree it would build new venvs on a nearly full disk.
# Venvs: ZPKT_ROOT if set, else this checkout, else (a worktree without venvs) the main checkout
# that the worktree belongs to.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
pick_root() {
  if [[ -n "${ZPKT_ROOT:-}" ]]; then echo "$ZPKT_ROOT"; return; fi
  local top common
  top="$(git -C "$here" rev-parse --show-toplevel)"
  if [[ -d "$top/ears/mlab/.venv" ]]; then echo "$top"; return; fi
  common="$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)"
  dirname "$common"
}
root="$(pick_root)"
which=0 project="" hands_cli=0
case "${1:-}" in
  --which) which=1; shift ;;
  --hands) hands_cli=1; shift ;;
  --in)
    case "${2:-}" in
      mlab) project="$root/ears/mlab" ;;
      hands) project="$root/hands" ;;
      voice) project="$root/lib/voice"; export HF_HUB_OFFLINE=1 ;;
      *) echo "--in takes mlab, hands or voice" >&2; exit 2 ;;
    esac
    shift 2 ;;
esac
if [[ $hands_cli == 1 ]]; then
  [[ -d "$root/hands/.venv" ]] || { echo "no venv in $root/hands: set ZPKT_ROOT to a checkout that has one" >&2; exit 2; }
  exec nice -n 10 uv run -q --project "$root/hands" --no-sync hands "$@"
fi
script="${1:?usage: run [--in PROJECT] SCRIPT.py|PATH [ARGS...]  or  run --hands ARGS}"
shift
if [[ "$script" == */* ]]; then file="$script"; else file="$here/$script"; fi
if [[ -z "$project" ]]; then
  case "$script" in
    transcribe.py) project="$root/lib/voice"; export HF_HUB_OFFLINE=1 ;;
    preflight.py|live_step.py|render.py) project="$root/hands" ;;
    *) project="$root/ears/mlab" ;;
  esac
fi
if [[ $which == 1 ]]; then echo "$project"; exit 0; fi
[[ -f "$file" ]] || { echo "no script $file" >&2; exit 2; }
[[ -d "$project/.venv" ]] || { echo "no venv in $project: set ZPKT_ROOT to a checkout that has its venvs (never uv sync into a worktree on this disk)" >&2; exit 2; }
exec nice -n 10 uv run -q --project "$project" --no-sync python -I "$file" "$@"
