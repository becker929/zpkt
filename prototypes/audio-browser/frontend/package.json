{
  "name": "audio-browser-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:mock": "NEXT_PUBLIC_MOCK=1 next dev -p 3100",
    "schema": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/emit-schema.mjs",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test --project=mock",
    "test:e2e:live": "playwright test --project=live",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:cap1": "playwright test --project=cap1",
    "test:e2e:install": "playwright install chromium webkit"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "swr": "^2.3.6",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  }
}
