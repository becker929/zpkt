{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://audio-browser.local/schemas/board.schema.json",
  "title": "Board",
  "description": "GET /api/board: the columns the server serves, with their caps and occupancy, plus the counts that sit\noff the board.\n\nGenerated from frontend/lib/project.ts by frontend/scripts/emit-schema.mjs. Do not edit.\n\n`over` is the server's reading of its own cap. The client draws what the server reports and\nnever decides for itself what counts as over.",
  "type": "object",
  "properties": {
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "column": {
            "type": "string",
            "enum": [
              "stored",
              "collage",
              "enrich"
            ]
          },
          "cap": {
            "type": "integer",
            "minimum": 0
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "unreadable": {
            "type": "integer",
            "minimum": 0
          },
          "over": {
            "type": "boolean"
          }
        },
        "required": [
          "column",
          "cap",
          "count",
          "unreadable",
          "over"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 3
    },
    "encumbrance": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "released": {
      "type": "integer",
      "minimum": 0
    },
    "abandoned": {
      "type": "integer",
      "minimum": 0
    },
    "unreadable": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "columns",
    "encumbrance",
    "released",
    "abandoned",
    "unreadable"
  ],
  "additionalProperties": false
}
