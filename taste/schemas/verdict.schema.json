{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/scalingtaste/taste/schemas/verdict.schema.json",
  "title": "Verdict",
  "description": "Taste judge output for a single render. Produced by taste, optionally consumed by hands.",
  "type": "object",
  "required": ["clip_id", "score", "rationale"],
  "properties": {
    "clip_id":       { "type": "string" },
    "score":         { "type": "integer", "minimum": 1, "maximum": 5 },
    "rationale":     { "type": "string" },
    "suggestions":   { "type": "array", "items": { "type": "string" } },
    "retrieved_ids": { "type": "array", "items": { "type": "string" } },
    "model":         { "type": "string" }
  }
}
